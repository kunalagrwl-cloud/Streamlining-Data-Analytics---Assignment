                      "spec": {
                        "dataset": "smart_city_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \r\n  location_name AS metric,\r\n  ROUND(AVG(wind_speed_kmh), 1) AS \"Avg Wind Speed (km/h)\",\r\n  ROUND(MAX(wind_speed_kmh), 1) AS \"Peak Gust (km/h)\",\r\n  ROUND(AVG(precipitation_mm), 2) AS \"Rainfall (mm)\"\r\nFROM weather\r\nWHERE location_name IS NOT NULL\r\nGROUP BY location_name\r\nORDER BY \"Avg Wind Speed (km/h)\" DESC;",
                        "sql": {
                          "columns": [
