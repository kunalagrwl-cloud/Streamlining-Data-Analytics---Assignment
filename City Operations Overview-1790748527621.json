                        "rawQuery": true,
                        "rawSql": "SELECT \r\n  CASE \r\n    WHEN aqi <= 50 THEN 'Good (0-50)'\r\n    WHEN aqi <= 100 THEN 'Moderate (51-100)'\r\n    WHEN aqi <= 200 THEN 'Unhealthy (101-200)'\r\n    WHEN aqi <= 300 THEN 'Very Unhealthy (201-300)'\r\n    ELSE 'Hazardous (300+)'\r\n  END AS metric,\r\n  COUNT(*) AS value\r\nFROM air_quality\r\nGROUP BY metric;",
